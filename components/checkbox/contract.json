{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.checkbox",
    "name": "Checkbox",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0-alpha.2",
    "summary": "FinCore's native single-option checkbox: control + label + helper/error, four mutually exclusive states, an independent focus ring and only checkbox.* component tokens. Implemented as framework-agnostic CSS with native HTML semantics.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Input and Select canonical patterns.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with 27 checkbox.* component tokens.",
        "The stylesheet consumes only variables generated from checkbox.* component tokens.",
        "No Figma component set exists for Checkbox in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the checkbox anatomy: native checkbox control, checkmark icon indicator, label, and optional helper/error row.",
      "Apply only checkbox.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay when keyboard focus is present, except when disabled.",
      "Expose native checkbox semantics, the native checked and disabled states."
    ],
    "application": [
      "Supply the label and manage the checked/unchecked state.",
      "Own validation: decide when a value is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby.",
      "Use native disabled only when the control is genuinely unavailable.",
      "Never use Checkbox for mutual exclusion where Radio is required."
    ],
    "figmaOnly": [
      "No Figma component set exists for Checkbox in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Single binary choices such as accepting terms and conditions.",
      "Selecting multiple independent options from a list."
    ],
    "inappropriate": [
      {
        "use": "Mutually exclusive options.",
        "reason": "Radio buttons are the accessible pattern for mutually exclusive options.",
        "alternative": "Use Radio Group."
      },
      {
        "use": "Instant action toggles.",
        "reason": "Checkboxes require a form submission or explicit save step.",
        "alternative": "Use a toggle switch."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Field: container with label wrapper and helper/error message.",
      "Body: horizontal row containing control box and label text.",
      "Control: 16px square with 1px border, 4px radius, checkmark icon.",
      "Focus Ring: absolute overlay, 2px stroke, 6px concentric radius on :focus-visible.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
