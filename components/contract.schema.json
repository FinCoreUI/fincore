{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fincore:component-contract:1.0.0",
  "title": "FinCore Component Contract",
  "description": "Stage 1 machine-readable contract format for FinCore components. The contract separates design evidence from production requirements and never invents component capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "responsibilities",
    "use",
    "anatomy",
    "properties",
    "codeOnlyProperties",
    "variants",
    "stateModel",
    "tokens",
    "accessibility",
    "customisation",
    "composition",
    "invalidConfigurations",
    "tests",
    "limitations",
    "aiGuidance",
    "examples"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/contractMeta"
    },
    "responsibilities": {
      "$ref": "#/$defs/responsibilities"
    },
    "use": {
      "$ref": "#/$defs/use"
    },
    "anatomy": {
      "$ref": "#/$defs/anatomy"
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "codeOnlyProperties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/codeOnlyProperty"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "stateModel": {
      "$ref": "#/$defs/stateModel"
    },
    "tokens": {
      "$ref": "#/$defs/tokens"
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "customisation": {
      "$ref": "#/$defs/customisation"
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "invalidConfigurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invalidConfiguration"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/limitation"
      }
    },
    "aiGuidance": {
      "$ref": "#/$defs/aiGuidance"
    },
    "examples": {
      "$ref": "#/$defs/examples"
    }
  },
  "$defs": {
    "contractMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "componentVersion",
        "summary",
        "maturity",
        "lastUpdated",
        "canonical"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fincore\\.[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "stable", "deprecated"]
        },
        "componentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        },
        "lastUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "canonical": {
          "$ref": "#/$defs/canonical"
        }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figma", "tokens", "css", "evidence"],
      "properties": {
        "figma": {
          "anyOf": [
            {
              "$ref": "#/$defs/figma"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileKey",
        "pageId",
        "pageName",
        "nodeId",
        "componentSet",
        "variantCount",
        "width",
        "height",
        "x",
        "y",
        "propertyKeys"
      ],
      "properties": {
        "fileKey": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "pageName": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "componentSet": {
          "type": "string",
          "minLength": 1
        },
        "variantCount": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "propertyKeys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "responsibilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "application", "figmaOnly"],
      "properties": {
        "component": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "application": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figmaOnly": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended", "inappropriate"],
      "properties": {
        "intended": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inappropriate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/useItem"
          }
        }
      }
    },
    "useItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "reason", "alternative"],
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "alternative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "geometry", "literals"],
      "properties": {
        "structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geometry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/geometry"
          }
        },
        "literals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value", "token"],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": ["string", "null"]
        }
      }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value", "reason"],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "figmaType",
        "figmaDefault",
        "required",
        "description",
        "translation",
        "production"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "figmaType": {
          "type": "string",
          "enum": ["VARIANT", "TEXT", "BOOLEAN"]
        },
        "figmaValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figmaKey": {
          "type": "string",
          "minLength": 1
        },
        "figmaDefault": {
          "type": ["string", "boolean", "number"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "enum": ["direct", "renamed", "derived", "figma-only", "code-only"]
        },
        "production": {
          "$ref": "#/$defs/production"
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop", "type", "default", "required", "derived", "notes"],
      "properties": {
        "prop": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": ["string", "boolean", "number", "null"]
        },
        "required": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "codeOnlyProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop", "type", "default", "required", "description"],
      "properties": {
        "prop": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": ["string", "boolean", "number", "null"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "figmaNodeId", "tokens", "notes"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "figmaNodeId": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "validCombinations", "precedence", "conflicts", "notes"],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateAxis"
          }
        },
        "validCombinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/combination"
          }
        },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stateAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "values"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["variant", "boolean", "derived"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combination", "supported", "result"],
      "properties": {
        "combination": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "type": "boolean"
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "dependencies", "stateMapping", "forbidden"],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tokenRef"
          }
        },
        "stateMapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateStyle"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tokenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "cssVar",
        "alias",
        "resolved",
        "role",
        "usedBy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["color", "dimension", "fontWeight"]
        },
        "cssVar": {
          "type": "string",
          "pattern": "^--fc-[a-z0-9-]+$"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": ["string", "number"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "usedBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "background", "foreground", "ring"],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": ["string", "null"]
        },
        "foreground": {
          "type": ["string", "null"]
        },
        "border": {
          "type": ["string", "null"]
        },
        "placeholder": {
          "type": ["string", "null"]
        },
        "label": {
          "type": ["string", "null"]
        },
        "helper": {
          "type": ["string", "null"]
        },
        "ring": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "production", "contrast"],
      "properties": {
        "design": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "production": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "contrast": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contrastRow"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contrastRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "foreground", "background", "minimum", "ratios", "status", "notes"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "foreground": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "ratios": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "status": {
          "type": "string",
          "enum": ["pass", "exempt", "advisory"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "customisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden", "themeOverrides"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "themeOverrides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "forbidden", "example"],
      "properties": {
        "canonical": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "example": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invalidConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configuration", "why", "correct"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "correct": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "behaviour", "accessibility", "tokens", "regression"],
      "properties": {
        "visual": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "behaviour": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "accessibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "regression": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "then": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "limitation", "impact", "mitigation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aiGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOrder", "rules", "uncertaintyPolicy", "definitionOfDone"],
      "properties": {
        "readOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertaintyPolicy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "definitionOfDone": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid"],
      "properties": {
        "valid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "invalid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "code", "explanation"],
