{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.currency",
    "name": "Currency",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0-alpha.2",
    "summary": "FinCore's native currency input: label + control with currency prefix/suffix + decimal formatting + helper/error message, four states, independent focus ring and only currency.* component tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Input canonical patterns with monetary prefix/suffix affordances.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with 28 currency.* component tokens.",
        "The stylesheet consumes only variables generated from currency.* component tokens.",
        "No Figma component set exists for Currency in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the currency field anatomy: label, control container with prefix symbol/suffix code, formatted numeric input, and helper/error row.",
      "Apply only currency.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay around the control wrapper when focused.",
      "Support numeric/decimal input with currency formatting."
    ],
    "application": [
      "Supply the label, currency symbol/code, and numeric amount.",
      "Own validation: decide when an entered amount is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby."
    ],
    "figmaOnly": [
      "No Figma component set exists for Currency in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Monetary amounts, deposits, withdrawals, transfers, payments and financial transactions."
    ],
    "inappropriate": [
      {
        "use": "Standard non-monetary numeric input such as quantities or years.",
        "reason": "Currency is tailored specifically for monetary formatting and currency affixes.",
        "alternative": "Use Input with type=\"number\"."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Field: vertical stack of label, control wrapper and helper/error message.",
      "Control wrapper: flex container housing prefix symbol, input field, and suffix code.",
      "Affixes: prefix symbol (e.g., $) and/or suffix currency code (e.g., USD).",
      "Field: 40px height, right-aligned numeric entry.",
      "Focus Ring: absolute sibling overlay on the control wrapper, 2px stroke, 8px concentric radius.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
    "geometry": [
      {
        "property": "control height",
        "value": "40px",
