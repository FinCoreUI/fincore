    "id": "fincore.cvv",
    "name": "CVV",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0-alpha.2",
    "summary": "FinCore native CVV input: label + masked card security code input with short length restriction + optional visibility toggle + helper/error message, four states, independent focus ring and only cvv.* component tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Input and PasswordInput canonical patterns for card security code (CVV/CVC) input.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with cvv.* component tokens.",
        "The stylesheet consumes only variables generated from cvv.* component tokens.",
        "No Figma component set exists for CVV in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the CVV field anatomy: label, control container with short-width masked input, optional toggle button, and helper/error row.",
      "Apply only cvv.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay around the control wrapper when focused.",
      "Support masked password-style security code entry with length restriction."
    ],
    "application": [
      "Supply the label, value, and length limit (e.g. 3 or 4 digits).",
      "Own validation: decide when an entered CVV is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby."
    ],
    "figmaOnly": [
      "No Figma component set exists for Currency in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Card security code (CVV, CVC, CID) verification in checkout, payment and card management flows."
    ],
    "inappropriate": [
      {
        "use": "Standard multi-field password input or account passwords.",
        "reason": "CVV is tailored specifically for short numeric security codes with restricted character length.",
        "alternative": "Use PasswordInput."
      }
    ]
  },
