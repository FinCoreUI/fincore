  "responsibilities": {
    "component": [
      "Render the DatePicker field anatomy: label, control container with native date input, calendar trigger styling, and helper/error row.",
      "Apply only date-picker.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay around the control wrapper when focused.",
      "Support native date picker interaction and min/max date limits."
    ],
    "application": [
      "Supply the label, selected date value, and optional min/max range constraints.",
      "Own validation: decide when an entered date is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby."
    ],
    "figmaOnly": [
      "No Figma component set exists for Currency in v0.1; there are no design-time properties to translate."
    ]
  },
