{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.otp",
    "name": "OTP",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0-alpha.2",
    "summary": "FinCore's native OTP input: label + group of single-character digit cells + helper/error message, four states, independent focus ring and only otp.* component tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Input canonical patterns with single-character cells.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with 27 otp.* component tokens.",
        "The stylesheet consumes only variables generated from otp.* component tokens.",
        "No Figma component set exists for OTP in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the OTP anatomy: label, row of single-character input cells, and helper/error row.",
      "Apply only otp.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for each cell surface and border.",
      "Render the focus ring as an independent overlay on the focused cell.",
      "Handle single-digit input, auto-advancing to the next cell, backspace navigation, and paste distribution."
    ],
    "application": [
      "Provide the label and handle the completed code.",
      "Own validation: decide when an entered code is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby."
    ],
    "figmaOnly": [
      "No Figma component set exists for OTP in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "One-time passwords, 2FA/MFA verification codes, and security PINs."
    ],
    "inappropriate": [
      {
        "use": "Standard arbitrary-length text entry.",
        "reason": "OTP is designed for fixed-length segmented codes.",
        "alternative": "Use Input."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Field: container with label, horizontal row of cells, and helper/error message.",
      "Cell wrapper: relative container for each single-character input and its focus ring overlay.",
      "Cell: 40px square input with centered text.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
    "geometry": [
      {
        "property": "cell size",
        "value": "40px",
        "token": "otp.cell-size"
      },
      {
        "property": "cell gap",
        "value": "8px",
        "token": "otp.cell-gap"
      },
      {
        "property": "cell corner radius",
        "value": "6px",
        "token": "otp.radius"
      },
      {
        "property": "border width",
        "value": "1px",
        "token": "otp.border-width"
      },
      {
        "property": "label gap",
        "value": "8px",
        "token": "otp.label-gap"
      },
      {
        "property": "helper gap",
        "value": "4px",
        "token": "otp.helper-gap"
      },
      {
        "property": "focus ring width",
        "value": "2px",
        "token": "otp.focus.width"
      },
      {
        "property": "focus ring offset",
        "value": "2px",
        "token": "otp.focus.offset"
      },
      {
        "property": "focus ring radius",
        "value": "8px",
        "token": "otp.focus.radius"
      }
    ],
    "literals": []
  },
  "properties": [
    {
      "name": "Label",
      "figmaType": "TEXT",
      "figmaDefault": "OTP",
      "required": true,
      "description": "Visible label for the OTP group.",
      "translation": "direct",
      "production": {
        "prop": "label",
        "type": "string",
        "default": null,
        "required": true,
        "derived": false,
        "notes": "Accessible name for the OTP group."
      }
    }
  ],
  "codeOnlyProperties": [
    {
      "prop": "length",
      "type": "number",
      "default": 6,
      "required": false,
      "description": "Number of OTP digit cells.",
      "notes": "Defaults to 6."
    },
    {
      "prop": "value",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Controlled value string.",
      "notes": "Length matches the cell count."
    },
    {
      "prop": "onChange",
      "type": "(value: string) => void",
      "default": null,
      "required": false,
      "description": "Callback fired when any digit changes.",
      "notes": "Provides current code string."
    },
    {
      "prop": "onComplete",
      "type": "(value: string) => void",
      "default": null,
      "required": false,
      "description": "Callback fired when all cells are filled.",
      "notes": "Useful for auto-submitting verification."
    },
    {
      "prop": "errorMessage",
      "type": "string",
      "default": null,
      "required": false,
      "description": "When non-empty, sets aria-invalid and displays error message.",
      "notes": "Application owns error copy."
    },
    {
      "prop": "helperText",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Supporting copy shown when there is no error.",
      "notes": "Replaced by error message."
    }
  ],
  "variants": [
    {
      "name": "Default",
      "figmaNodeId": "0:0",
      "tokens": [
        "otp.cell-size",
        "otp.cell-gap",
        "otp.radius",
        "otp.border-width",
        "otp.font-size",
        "otp.line-height",
        "otp.font-weight",
