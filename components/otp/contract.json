        "otp.focus.color",
        "otp.focus.width",
        "otp.focus.offset",
        "otp.focus.radius",
        "otp.background",
        "otp.border",
        "otp.text",
        "otp.border-hover",
        "otp.border-error",
        "otp.text-error",
        "otp.background-disabled",
        "otp.border-disabled",
        "otp.text-disabled",
        "otp.label.color",
        "otp.label.font-weight",
        "otp.helper.color",
        "otp.helper.font-size",
        "otp.helper.line-height"
      ],
      "notes": "Runtime token surface."
    }
  ],
  "stateModel": {
    "axes": [
      {
        "name": "State",
        "kind": "variant",
        "values": [
          "Default",
          "Hover",
          "Error",
          "Disabled"
        ]
      }
    ],
    "validCombinations": [
      {
        "combination": "Default",
        "supported": true,
        "result": "White fill, control border, normal label."
      },
      {
        "combination": "Hover",
        "supported": true,
        "result": "Hover border boundary."
      },
      {
        "combination": "Error",
        "supported": true,
        "result": "Error border and error message."
      },
      {
        "combination": "Disabled",
        "supported": true,
        "result": "Muted fill, muted border, muted label; no interaction."
      }
    ],
    "precedence": [
      "State precedence: Disabled > Error > Hover > Default.",
      "Focus is orthogonal to State in Default, Hover and Error.",
      "Disabled suppresses focus entirely."
    ],
    "conflicts": [
      "Error + Hover is not modelled. Error border persists."
    ],
    "notes": [
      "Focus ring is an overlay, not a state."
    ]
  },
