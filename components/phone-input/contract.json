        "x": 0,
        "y": 0,
        "propertyKeys": {
          "Label": "Label"
        }
      },
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Follows FinCore contract schema and Input anatomy patterns.",
        "Designed for international use with no forced country default and no IP geolocation.",
        "Distinguishes editing text, normalised international values and validation status.",
        "Numbering-plan validation cannot prove a number is active, reachable or owned."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the full field anatomy with label, country selector, number input and helper or error row.",
      "Apply only phone-input component tokens for colour, geometry and typography.",
      "Expose accessible labeling and association between label, country selector, input and messages.",
      "Support keyboard navigation for the country selector where implemented by the adapter.",
      "Expose native disabled state and suppress focus treatments when disabled."
    ],
    "application": [
      "Choose or infer the appropriate default country without relying on IP geolocation.",
      "Supply required-field validation and user-facing error copy.",
      "Decide when to require a complete international number and when to validate.",
      "Handle form submission, focus management and announcements."
    ],
    "figmaOnly": [
      "State is design metadata only in this draft and production derives state from interaction.",
      "Label is demo content in Figma and production copy is supplied by the application."
    ]
  },
  "use": {
    "intended": [
      "Collecting international phone numbers in global forms where users may travel.",
      "Forms requiring E.164 normalisation when a valid international number is provided."
    ],
    "inappropriate": [
      {
        "use": "Assuming a single country for all users without explicit configuration.",
        "reason": "FinCore is international and hardcoding a country is not allowed.",
        "alternative": "Infer from an existing international number or require explicit selection with no forced default."
      },
      {
        "use": "Treating a calling code alone as a unique country identifier.",
        "reason": "Multiple countries share calling codes.",
        "alternative": "Present full country names in the selector and allow disambiguation."
      },
      {
        "use": "Using IP geolocation to auto-select a country.",
        "reason": "Not permitted due to privacy and accuracy concerns.",
        "alternative": "Use explicit defaultCountry, infer from an E.164 value or no default."
      }
    ]
  },
