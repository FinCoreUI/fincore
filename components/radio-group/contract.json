{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.radio-group",
    "name": "Radio Group",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0",
    "summary": "FinCore's native radio group: fieldset + legend + native radio controls with shared name + helper/error message, four states, independent circular focus ring and only radio-group.* component tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Checkbox, Input and Select canonical patterns.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with 27 radio-group.* component tokens.",
        "The stylesheet consumes only variables generated from radio-group.* component tokens.",
        "No Figma component set exists for Radio Group in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the radio group anatomy: group legend/label, native radio inputs with a shared name, circular indicator with inner dot, and helper/error row.",
      "Apply only radio-group.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the circular focus ring as an independent overlay when keyboard focus is present, except when disabled.",
      "Expose native radio group keyboard navigation (Arrow keys) and accessibility semantics."
    ],
    "application": [
      "Supply the group label, options list, and manage the selected value.",
      "Own validation: decide when a value is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby.",
      "Use native disabled only when the control is genuinely unavailable."
    ],
    "figmaOnly": [
      "No Figma component set exists for Radio Group in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Choosing one option from a small, fixed set of 2–7 mutually exclusive choices.",
      "Scenarios where all options need to be visible upfront without opening a dropdown."
    ],
    "inappropriate": [
      {
        "use": "Selecting multiple options simultaneously.",
        "reason": "Radio inputs are strictly mutually exclusive.",
        "alternative": "Use Checkbox."
      },
      {
        "use": "Long lists of 8+ options.",
        "reason": "Takes excessive vertical space.",
        "alternative": "Use Select."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Fieldset: container with legend and helper/error message.",
      "Items: column stack of radio option items.",
      "Item: row containing radio circle and option label.",
      "Control: 16px circular button with 8px inner dot when checked.",
      "Focus Ring: circular absolute overlay, 2px stroke, 2px offset.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
    "geometry": [
      {
        "property": "control size",
        "value": "16px",
