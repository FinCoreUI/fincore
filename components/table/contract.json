{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.table",
    "name": "Table",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0",
    "summary": "FinCore native Table: tabular financial data presentation using only table.* tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring canonical patterns for Table."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the Table field anatomy: label, control container with native date input, calendar trigger styling, and helper/error row.",
      "Apply only table.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay around the control wrapper when focused.",
      "Support native date picker interaction and min/max date limits."
    ],
    "application": [
      "Supply the label, selected date value, and optional min/max range constraints.",
      "Own validation: decide when an entered date is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby."
    ],
    "figmaOnly": [
      "No Figma component set exists for Currency in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Date of birth, transaction date filters, payment scheduled dates, statement periods, and maturity dates."
    ],
    "inappropriate": [
      {
        "use": "Free-form text input or non-date numeric values.",
        "reason": "Table is tailored specifically for standardized ISO date formats (YYYY-MM-DD).",
        "alternative": "Use Input."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Field: vertical stack of label, control wrapper and helper/error message.",
      "Control wrapper: flex container housing the native date field and calendar indicator.",
      "Field: 40px height, formatted date entry.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
    "geometry": [
      {
        "property": "border width",
        "value": "1px",
        "token": "table.border-width"
      },
      {
        "property": "header padding x",
        "value": "16px",
        "token": "table.header-padding-x"
      },
      {
        "property": "header padding y",
        "value": "12px",
        "token": "table.header-padding-y"
      },
      {
        "property": "cell padding x",
        "value": "16px",
        "token": "table.cell-padding-x"
      },
      {
        "property": "cell padding y",
        "value": "12px",
        "token": "table.cell-padding-y"
      }
    ],
    "literals": []
  },
  "properties": [
    {
      "name": "Data",
      "figmaType": "TEXT",
      "figmaDefault": "Table data",
      "required": true,
      "description": "Table row content.",
      "translation": "direct",
      "production": {
        "prop": "children",
        "type": "ReactNode",
        "default": null,
        "required": false,
        "derived": false,
        "notes": "Table body rows"
      }
    }
  ],
  "codeOnlyProperties": [
    {
      "prop": "id",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Stable id used for the label association and message references.",
      "notes": "Generated if omitted."
    },
    {
      "prop": "prefix",
      "type": "string",
      "default": "\"$\"",
      "required": false,
      "description": "Currency prefix symbol.",
      "notes": "Defaults to \"$\"."
    },
    {
      "prop": "suffix",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Currency suffix code, e.g., \"USD\".",
      "notes": "Optional currency ISO code."
    },
    {
      "prop": "value",
      "type": "string | number",
      "default": null,
      "required": false,
      "description": "Controlled amount value.",
      "notes": "Formatted or numeric amount."
    },
    {
      "prop": "errorMessage",
      "type": "string",
      "default": null,
      "required": false,
      "description": "When non-empty, sets aria-invalid and displays error message.",
      "notes": "Application owns error copy."
    },
    {
      "prop": "helperText",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Supporting copy shown when there is no error.",
      "notes": "Replaced by error message."
    },
    {
      "prop": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "default": "\"md\"",
      "required": false,
      "description": "Controls the size variant (sm, md, lg).",
      "notes": "Applies corresponding size modifier class."
    },
    {
      "prop": "loading",
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "Applies loading state and sets aria-busy=\"true\".",
      "notes": "Suppresses interactions while loading."
    }
  ],
