{
  "$schema": "../contract.schema.json",
  "contract": {
    "id": "fincore.textarea",
    "name": "Textarea",
    "version": "1.0.0",
    "status": "draft",
    "componentVersion": "0.1.0",
    "summary": "FinCore's native multiline text area: label + control + helper/error message, four states, independent focus ring and only textarea.* component tokens.",
    "maturity": "implemented; framework-agnostic CSS + native HTML; no Figma source",
    "lastUpdated": "2026-11-06",
    "canonical": {
      "figma": null,
      "tokens": "tokens/tokens.json",
      "css": "tokens/dist/tokens.css",
      "evidence": [
        "Local construction mirroring Input canonical patterns with multiline sizing.",
        "The token block was added to tokens/tokens.json and generated into tokens/dist/tokens.css; node tokens/check.mjs passed with 28 textarea.* component tokens.",
        "The stylesheet consumes only variables generated from textarea.* component tokens.",
        "No Figma component set exists for Textarea in v0.1, so canonical.figma is null and no design-evidence claims are made."
      ]
    }
  },
  "responsibilities": {
    "component": [
      "Render the textarea field anatomy: label, native textarea control, and helper/error row.",
      "Apply only textarea.* component tokens for colour, geometry and typography.",
      "Resolve Disabled > Error > Hover > Default for the control surface and border.",
      "Render the focus ring as an independent overlay when keyboard focus is present, except when disabled.",
      "Expose native textarea semantics and support vertical resizing by default."
    ],
    "application": [
      "Provide the label and control value.",
      "Own validation: decide when a value is invalid and what the error says.",
      "Set aria-invalid and connect the error or helper message with aria-describedby.",
      "Use native disabled only when the control is genuinely unavailable."
    ],
    "figmaOnly": [
      "No Figma component set exists for Textarea in v0.1; there are no design-time properties to translate."
    ]
  },
  "use": {
    "intended": [
      "Multiline free-text entry such as comments, descriptions, notes, or messages.",
      "Form fields where the anticipated input exceeds a single line."
    ],
    "inappropriate": [
      {
        "use": "Single-line values such as email, phone or currency.",
        "reason": "Textarea does not constrain to a single line or provide inputmode optimizations.",
        "alternative": "Use Input or PhoneInput."
      }
    ]
  },
  "anatomy": {
    "structure": [
      "Field: vertical stack of label, control wrapper and helper/error message.",
      "Label: 14/20, weight 500, label.color.",
      "Control: 80px min-height, 1px inside border, 6px radius, white fill by default.",
      "Focus Ring: absolute sibling overlay, 2px stroke, 8px concentric radius on :focus-visible.",
      "Message: 12/16, weight 400, helper.color or text-error."
    ],
    "geometry": [
      {
        "property": "min-height",
        "value": "80px",
        "token": "textarea.min-height"
      },
      {
        "property": "horizontal padding",
        "value": "12px",
        "token": "textarea.padding-x"
      },
      {
        "property": "vertical padding",
        "value": "8px",
        "token": "textarea.padding-y"
      },
      {
        "property": "corner radius",
        "value": "6px",
        "token": "textarea.radius"
      },
      {
        "property": "border width",
        "value": "1px",
        "token": "textarea.border-width"
      },
      {
        "property": "label gap",
        "value": "8px",
        "token": "textarea.label-gap"
      },
      {
        "property": "helper gap",
        "value": "4px",
        "token": "textarea.helper-gap"
      },
      {
        "property": "focus ring width",
        "value": "2px",
        "token": "textarea.focus.width"
      },
      {
        "property": "focus ring offset",
        "value": "2px",
        "token": "textarea.focus.offset"
      },
